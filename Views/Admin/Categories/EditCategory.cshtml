@model RestaurantSystem.ViewModels.CategoryFormViewModel

@{
    ViewData["Title"] = "Edit Category";
}

<div class="container mt-4">
    <div class="card shadow-sm col-md-8 mx-auto">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0">Edit Category</h4>
        </div>
        <div class="card-body">
            <form asp-action="EditCategory" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="CategoryId" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mb-2">
                            <img src="@Model.ImageUrl" width="120" height="120" class="rounded border object-fit-cover" alt="Current Image" />
                        </div>
                    }
                    <label asp-for="ImageFile" class="form-label">Change Image (Optional)</label>
                    <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                </div>

                <button type="submit" class="btn btn-primary">Update</button>
                <a asp-action="Categories" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>