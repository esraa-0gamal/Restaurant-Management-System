@model RestaurantSystem.Models.Category

@{
    ViewData["Title"] = "Category Details";
}

<div class="container mt-4">
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Category Details: @Model.Name</h4>
            <div>
                <a asp-action="EditCategory" asp-route-id="@Model.CategoryId" class="btn btn-warning btn-sm">Edit Category</a>
                <a asp-action="Categories" class="btn btn-light btn-sm">Back to List</a>
            </div>
        </div>
        <div class="card-body d-flex align-items-center">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" width="100" height="100" class="rounded me-3 border object-fit-cover" alt="@Model.Name" />
            }
            <div>
                <h5>@Model.Name</h5>
                <p class="text-muted mb-0">Total Dishes: @(Model.Dishes?.Count ?? 0)</p>
            </div>
        </div>
    </div>

    <h4 class="mb-3">Dishes in this Category</h4>
    <table class="table table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>Dish Name</th>
                <th>Price</th>
                <th>Status</th>
                <th style="width: 120px;">Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Dishes != null && Model.Dishes.Any())
            {
                @foreach (var dish in Model.Dishes)
                {
                    <tr>
                        <td>@dish.Name</td>
                        <td>@dish.Price.ToString("C")</td>
                        <td>
                            @if (dish.IsSoldOut)
                            {
                                <span class="badge bg-danger">Sold Out</span>
                            }
                            else if (dish.IsAvailable)
                            {
                                <span class="badge bg-success">Available</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Unavailable</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@dish.DishId" class="btn btn-sm btn-outline-info">View Dish</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">No dishes assigned to this category yet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>