@model RestaurantSystem.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container mt-4">
    <div class="alert alert-danger">
        <h4>Are you sure you want to delete this category?</h4>
        @if (Model.Dishes != null && Model.Dishes.Any())
        {
            <p class="fw-bold mb-0">
                Warning: This category has (@Model.Dishes.Count) associated dishes. You must delete or reassign them before deleting this category.
            </p>
        }
    </div>

    <div class="card mb-3 col-md-6">
        <div class="card-body">
            <h5 class="card-title">@Model.Name</h5>
            <p class="card-text">Total Dishes: @(Model.Dishes?.Count ?? 0)</p>
        </div>
    </div>

    <form asp-action="DeleteCategory" method="post">
        <input type="hidden" asp-for="CategoryId" />
        <button type="submit" class="btn btn-danger" @(Model.Dishes != null && Model.Dishes.Any() ? "disabled" : "")>
            Confirm Delete
        </button>
        <a asp-action="Categories" class="btn btn-secondary">Cancel</a>
    </form>
</div>