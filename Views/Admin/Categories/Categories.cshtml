@model IEnumerable<RestaurantSystem.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="container mt-4">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Categories</h2>
        <a asp-action="CreateCategory" class="btn btn-primary">+ Add New Category</a>
    </div>

    <table class="table table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th style="width: 100px;">Image</th>
                <th>Category Name</th>
                <th>Dishes Count</th>
                <th style="width: 260px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">No categories found.</td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <img src="@(item.ImageUrl ?? "/images/default-category.png")"
                             width="60" height="60" class="rounded object-fit-cover border" alt="@item.Name" />
                    </td>
                    <td class="fw-bold">@item.Name</td>
                    <td>
                        <span class="badge bg-secondary">@(item.Dishes?.Count ?? 0) Dishes</span>
                    </td>
                    <td>
                        <a asp-action="EditCategory" asp-route-id="@item.CategoryId" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="CategoryDetails" asp-route-id="@item.CategoryId" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="DeleteCategory" asp-route-id="@item.CategoryId" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>