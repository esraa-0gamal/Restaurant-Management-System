@model RestaurantSystem.Models.Dish

<div class="container mt-4">
    <div class="alert alert-danger">
        <h4>Are you sure you want to delete this dish?</h4>
        <p>This action cannot be undone if the dish is linked to previous orders.</p>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">@Model.Name</h5>
            <p class="card-text"><strong>Price: </strong>@Model.Price.ToString("C")</p>
            <p class="card-text"><strong>Category: </strong>@Model.Category?.Name</p>
        </div>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="DishId" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-action="Dishes" class="btn btn-secondary">Cancel</a>
    </form>
</div>