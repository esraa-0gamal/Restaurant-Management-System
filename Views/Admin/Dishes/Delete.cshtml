@model RestaurantSystem.Models.Dish

<div class="container mt-4">
    <div class="alert alert-danger">
        <h4>هل أنت متأكد من حذف هذا الطبق؟</h4>
        <p>لا يمكن التراجع عن هذه العملية إذا كان الطبق غير مرتبط بطلبات سابقة.</p>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">@Model.Name</h5>
            <p class="card-text"><strong>السعر: </strong>@Model.Price.ToString("C")</p>
            <p class="card-text"><strong>القسم: </strong>@Model.Category?.Name</p>
        </div>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="DishId" />
        <button type="submit" class="btn btn-danger">تأكيد الحذف</button>
        <a asp-action="Dishes" class="btn btn-secondary">إلغاء</a>
    </form>
</div>