@model IEnumerable<RestaurantSystem.Models.Coupon>

@{
    ViewData["Title"] = "Coupons";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Coupons & Discounts</h2>
        <a asp-action="CreateCoupon" class="btn btn-primary">+ Add New Coupon</a>
    </div>

    <table class="table table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Code</th>
                <th>Discount</th>
                <th>Expiry Date</th>
                <th>Status</th>
                <th style="width: 180px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">No coupons available.</td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold fs-5 text-primary font-monospace">@item.Code</td>
                    <td class="fw-bold text-success">@item.DiscountAmount.ToString("C")</td>
                    <td>@item.ExpiryDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        @if (item.IsActive && item.ExpiryDate >= DateTime.Today)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else if (item.ExpiryDate < DateTime.Today)
                        {
                            <span class="badge bg-danger">Expired</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Disabled</span>
                        }
                    </td>
                    <td>
                        <a asp-action="EditCoupon" asp-route-id="@item.CouponId" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="DeleteCoupon" asp-route-id="@item.CouponId" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>