@model RestaurantSystem.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid mt-4">

    <div class="card shadow-sm border-0 mb-4 bg-body">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="fs-4 fw-bold text-light me-3">🍽️ Restaurant Admin</span>
                <a asp-action="Categories" class="btn btn-outline-primary shadow-sm">
                    📁 Categories
                </a>
                <a asp-action="Dishes" class="btn btn-outline-success shadow-sm">
                    🍲 Dishes
                </a>
                <a asp-action="Tables" class="btn btn-outline-warning text-warning shadow-sm">
                    🪑 Tables
                </a>

                
               
                <a asp-action="Users" class="btn btn-outline-success shadow-sm">
                    👥 Users & Roles
                </a>

                <a asp-action="Coupons" class="btn btn-outline-danger shadow-sm">
                    🎟️ Coupons
                </a>

            </div>

            <!-- زر توليد الأوردرات التجريبية -->
            <form asp-action="SeedSampleOrders" method="post" class="m-0">
                <button type="submit" class="btn btn-success shadow-sm">
                    ⚡ Generate Sample Orders
                </button>
            </form>
        </div>
    </div>

    <!-- كروت الإحصائيات السريعة بارتفاع موحد متناسق -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 bg-primary text-white p-3 rounded-3 h-100">
                <div class="d-flex justify-content-between align-items-center h-100">
                    <div>
                        <span class="text-white-50 text-uppercase small fw-semibold d-block mb-1">Total Orders</span>
                        <h2 class="mb-0 fw-bold">@Model.TotalOrders</h2>
                    </div>
                    <span class="fs-1 opacity-75">📦</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 bg-success text-white p-3 rounded-3 h-100">
                <div class="d-flex justify-content-between align-items-center h-100">
                    <div>
                        <span class="text-white-50 text-uppercase small fw-semibold d-block mb-1">Total Sales</span>
                        <h2 class="mb-0 fw-bold">@Model.TotalSales.ToString("C")</h2>
                    </div>
                    <span class="fs-1 opacity-75">💰</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 bg-warning text-dark p-3 rounded-3 h-100">
                <div class="d-flex justify-content-between align-items-center h-100">
                    <div>
                        <span class="text-black-50 text-uppercase small fw-semibold d-block mb-1">Pending Orders</span>
                        <h2 class="mb-0 fw-bold">@Model.PendingOrders</h2>
                    </div>
                    <span class="fs-1 opacity-75">⏳</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 bg-info text-white p-3 rounded-3 h-100">
                <div class="d-flex justify-content-between align-items-center h-100">
                    <div>
                        <span class="text-white-50 text-uppercase small fw-semibold d-block mb-1">Tables (Occupied/Total)</span>
                        <h2 class="mb-0 fw-bold">@Model.OccupiedTables / @Model.TotalTables</h2>
                    </div>
                    <span class="fs-1 opacity-75">🪑</span>
                </div>
            </div>
        </div>
    </div>

    <!-- جدول عرض الأوردرات وتعديل حالتها -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0 fw-bold">Recent Orders & Status Management</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Order #</th>
                            <th>Customer</th>
                            <th>Type / Table</th>
                            <th>Date</th>
                            <th>Total</th>
                            <th>Current Status</th>
                            <th style="width: 260px;">Change Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentOrders == null || !Model.RecentOrders.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-5">
                                    <p class="mb-2">No orders recorded yet.</p>
                                    <small>Use the "Generate Sample Orders" button above to insert test data.</small>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var order in Model.RecentOrders)
                            {
                                <tr>
                                    <td class="fw-bold">@order.OrderNumber</td>
                                    <td>@(order.User?.FullName ?? "Guest")</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@order.OrderType</span>
                                        @if (order.Table != null)
                                        {
                                            <span class="ms-1 fw-bold">Table #@order.Table.TableNumber</span>
                                        }
                                    </td>
                                    <td>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="fw-bold text-success">@order.TotalAmount.ToString("C")</td>
                                    <td>
                                        @switch (order.Status)
                                        {
                                            case "Completed":
                                                <span class="badge bg-success">Completed</span>
                                                break;
                                            case "Pending":
                                                <span class="badge bg-warning text-dark">Pending</span>
                                                break;
                                            case "Cooking":
                                                <span class="badge bg-info text-dark">Cooking</span>
                                                break;
                                            case "Cancelled":
                                                <span class="badge bg-danger">Cancelled</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@order.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        <form asp-action="UpdateOrderStatus" method="post" class="d-flex gap-2">
                                            <input type="hidden" name="orderId" value="@order.OrderId" />
                                            <select name="status" class="form-select form-select-sm">
                                                <option value="Pending" selected="@(order.Status == "Pending")">Pending</option>
                                                <option value="Cooking" selected="@(order.Status == "Cooking")">Cooking</option>
                                                <option value="Completed" selected="@(order.Status == "Completed")">Completed</option>
                                                <option value="Cancelled" selected="@(order.Status == "Cancelled")">Cancelled</option>
                                            </select>
                                            <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>



