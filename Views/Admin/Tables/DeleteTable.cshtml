@model RestaurantSystem.Models.RestaurantTable

@{
    ViewData["Title"] = "Delete Table";
}

<div class="container mt-4">
    <div class="alert alert-danger">
        <h4>Are you sure you want to delete this table?</h4>
        <p class="mb-0">Deleting this table will also cascade or set null on related orders and reservations.</p>
    </div>

    <div class="card mb-3 col-md-6">
        <div class="card-body">
            <h5 class="card-title">Table #@Model.TableNumber</h5>
            <p class="card-text mb-1"><strong>Capacity:</strong> @Model.Capacity Guests</p>
            <p class="card-text mb-1"><strong>Zone:</strong> @Model.LocationZone</p>
            <p class="card-text"><strong>Status:</strong> @Model.Status</p>
        </div>
    </div>

    <form asp-action="DeleteTable" method="post">
        <input type="hidden" asp-for="TableId" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-action="Tables" class="btn btn-secondary">Cancel</a>
    </form>
</div>