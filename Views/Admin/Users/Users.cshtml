@model IEnumerable<RestaurantSystem.ViewModels.UserItemViewModel>

@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>User & Role Management</h2>
        <div>
            <a asp-action="CreateUser" class="btn btn-primary">+ Add New User</a>
            <a asp-action="Dashboard" class="btn btn-outline-secondary">Dashboard</a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Current Role</th>
                            <th style="width: 140px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">No users found.</td>
                            </tr>
                        }
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="fw-bold">@user.FullName</td>
                                <td>@user.Email</td>
                                <td>@user.PhoneNumber</td>
                                <td>
                                    @switch (user.Role)
                                    {
                                        case "Admin":
                                            <span class="badge bg-danger">Admin</span>
                                            break;
                                        case "Staff":
                                            <span class="badge bg-warning text-dark">Staff</span>
                                            break;
                                        case "Customer":
                                            <span class="badge bg-primary">Customer</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@user.Role</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-outline-warning">
                                        Edit Role
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>