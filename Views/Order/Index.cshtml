@model IEnumerable<RestaurantSystem.Models.Order>

@{
    ViewData["Title"] = "My Orders";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-bag-check me-2 text-primary"></i>My Orders</h2>
        <a asp-controller="Menu" asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-plus-circle me-1"></i>New Order
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 text-center p-5 my-4">
            <div class="card-body">
                <i class="bi bi-cart-x text-muted display-1"></i>
                <h4 class="fw-bold mt-3">No orders found</h4>
                <p class="text-muted">You haven't placed any orders yet. Explore our delicious menu!</p>
                <a asp-controller="Menu" asp-action="Index" class="btn btn-primary px-4 mt-2">Browse Menu</a>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var order in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3 border-bottom-0">
                            <div>
                                <span class="fw-bold text-dark fs-5">Order #@order.OrderId</span>
                                <small class="text-muted d-block fs-7">@order.OrderDate.ToString("g")</small>
                            </div>
                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">@order.Status</span>
                        </div>

                        <div class="card-body pt-0">
                            <hr class="mt-0 mb-3 text-muted">
                            <p class="mb-2 fs-6"><strong>Type:</strong> <span class="badge bg-light text-dark border">@order.OrderType</span></p>

                            <h6 class="fw-bold mt-3 mb-2">Items Summary:</h6>
                            <ul class="list-group list-group-flush mb-3">
                                @foreach (var item in order.OrderItems)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-1 bg-transparent border-0 small text-muted">
                                        <span>@item.Dish?.Name <strong class="text-dark">x@item.Quantity</strong></span>
                                        <span>$@item.TotalPrice</span>
                                    </li>
                                }
                            </ul>

                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <span class="fw-bold">Total Amount:</span>
                                <span class="fw-bold text-primary fs-5">$@order.TotalAmount</span>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-0 pb-3 pt-0">
                            <a asp-controller="Order" asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-outline-primary w-100 fw-semibold">
                                View Details & Invoice
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
