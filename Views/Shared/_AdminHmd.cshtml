<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="adminHMD professional admin dashboard template">
    <title>Dashboard | adminHMD</title>

    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/assets/vendors/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="~/assets/css/style.css">
</head>

<body>
    <div class="admin-shell">
        <div class="sidebar-backdrop" data-sidebar-close></div>

        <aside class="admin-sidebar" id="adminSidebar" aria-label="Main navigation">
            <div class="sidebar-header">
                <a class="brand-mark" asp-controller="Menu" asp-action="Index" aria-label="adminHMD dashboard">
                    <span class="brand-icon"><i class="bi bi-grid-1x2-fill" aria-hidden="true"></i></span>
                    <span class="brand-copy">
                        <span class="brand-title">Restaurant System</span>
                        <span class="brand-subtitle">Dashboard</span>
                    </span>
                </a>
            </div>

           
            <ul class="nav flex-column p-2">
                <li class="nav-item mb-1">
                    <a class="nav-link text-white" asp-controller="Menu" asp-action="Index">
                        <i class="bi bi-menu-button-wide me-2"></i>Menu
                    </a>
                </li>
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <li class="nav-item mb-1">
                        <a class="nav-link text-white" asp-controller="Order" asp-action="Index">
                            <i class="bi bi-bag-check me-2"></i>My Orders
                        </a>
                    </li>
                }
            </ul>

            <div class="sidebar-footer mt-auto">
                <span class="status-dot"></span>
                <span class="sidebar-footer-text">System running smoothly</span>
            </div>
        </aside>

        <div class="admin-main">
            <nav class="navbar admin-navbar navbar-expand bg-white">
                <div class="container-fluid px-3 px-lg-4">
                    <button class="sidebar-toggle" type="button" data-sidebar-toggle aria-controls="adminSidebar" aria-expanded="true" aria-label="Toggle sidebar">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>

                    <form class="d-none d-md-flex ms-3 flex-grow-1" role="search">
                        <input class="form-control search-input" type="search" placeholder="Search dishes, orders..." aria-label="Search">
                    </form>

                   
                    <div class="navbar-actions ms-auto d-flex align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <a class="btn btn-outline-primary btn-sm fw-bold me-2" asp-controller="Order" asp-action="Index">
                                <i class="bi bi-bag-check me-1"></i>My Orders
                            </a>

                            <div class="dropdown">
                                <button class="btn btn-light dropdown-toggle d-flex align-items-center gap-2 shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5 text-primary"></i>
                                    <span class="fw-semibold">@User.Identity.Name</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Order" asp-action="Index">
                                            <i class="bi bi-bag me-2"></i>My Orders
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i>Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-outline-secondary btn-sm px-3" asp-controller="Account" asp-action="Login">Login</a>
                            <a class="btn btn-primary btn-sm px-3" asp-controller="Account" asp-action="Register">Register</a>
                        }
                    </div>
                </div>
            </nav>

            <main class="dashboard-content">
                @RenderBody()
            </main>

            <footer class="admin-footer">
                <div class="container-fluid px-3 px-lg-4">
                    <span>Copyright 2026 Restaurant System.</span>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/assets/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/main.js"></script>
</body>
</html>
