@model RestaurantSystem.Models.Dish

@{
    ViewData["Title"] = Model.Name + " - Details";
}

<div class="container py-5">
    <!-- Navigation Bar (Back to Menu & Cart) -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-dark rounded-pill px-4 fw-medium">
            ← Back to Menu
        </a>
        <a asp-controller="Cart" asp-action="Index" class="btn btn-dark rounded-pill px-4 fw-semibold">
            <i class="bi bi-cart3 me-1"></i> View Cart 🛒
        </a>
    </div>

    <!-- Success Message Alert -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Dish Details Card -->
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="row g-0 align-items-center">

            <!-- Dish Image Container (Fixed Aspect Ratio to Handle Tall Images) -->
            <div class="col-lg-6 position-relative bg-light text-center">
                <div style="height: 420px; width: 100%; overflow: hidden;" class="d-flex align-items-center justify-content-center">
                    <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/assets/images/default-dish.jpg" : Model.ImageUrl)"
                         class="w-100 h-100 object-fit-cover"
                         alt="@Model.Name"
                         onerror="this.src='https://images.pexels.com/photos/1279330/pexels-photo-1279330.jpeg';">
                </div>
            </div>

            <!-- Dish Info & Actions -->
            <div class="col-lg-6 p-4 p-md-5">
                <div class="mb-3">
                    @if (Model.Category != null)
                    {
                        <span class="badge bg-light text-dark border px-3 py-2 fs-6 rounded-pill fw-normal mb-2">
                            @Model.Category.Name
                        </span>
                    }
                    <h1 class="display-5 fw-bold text-dark mb-2">@Model.Name</h1>
                    <h3 class="fw-bold text-success display-6 mb-4">$@Model.Price.ToString("F2")</h3>
                </div>

                <p class="text-muted fs-6 mb-4 leading-relaxed">
                    @Model.Description
                </p>

                <hr class="my-4 text-muted opacity-25" />

                <!-- Add to Cart Form -->
                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                    <input type="hidden" name="dishId" value="@Model.DishId" />

                    <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-3">
                        <!-- Quantity Input -->
                        <div class="d-flex align-items-center gap-2">
                            <label for="quantity" class="fw-semibold text-dark mb-0">Quantity:</label>
                            <input type="number"
                                   id="quantity"
                                   name="quantity"
                                   value="1"
                                   min="1"
                                   max="20"
                                   class="form-control form-control-lg text-center rounded-3 border fw-bold"
                                   style="width: 90px;" />
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn btn-dark btn-lg rounded-3 flex-grow-1 fw-semibold py-2">
                            <i class="bi bi-bag-plus me-2"></i> Add to Cart
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

<style>
    /* Ensure any image fills nicely without distortion */
    .object-fit-cover {
        object-fit: cover;
    }
</style>