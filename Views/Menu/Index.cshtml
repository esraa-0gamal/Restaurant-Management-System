@model RestaurantSystem.Models.MenuVeiwModel

@{
    ViewData["Title"] = "Menu";
}

<div class="container py-5">
    <!-- Header Section With Cart Button -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-5 gap-3">
        <div class="text-center text-md-start">
            <h1 class="display-4 fw-bold text-dark tracking-tight mb-1">🍽️ Explore Our Menu</h1>
            <p class="text-muted fs-5 mb-0">Crafted with passion, served with perfection.</p>
        </div>
        <div>
            <a asp-controller="Cart" asp-action="Index" class="btn btn-dark btn-lg rounded-pill px-4 shadow-sm fw-semibold">
                <i class="bi bi-cart3 me-2"></i> View Cart 🛒
            </a>
        </div>
    </div>

    <!-- Search Bar -->
    <div class="row justify-content-center mb-4">
        <div class="col-md-7 col-lg-6">
            <form asp-action="Index" method="get" class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden border">
                <input type="text"
                       name="searchTerm"
                       value="@Model.SearchTerm"
                       class="form-control border-0 px-4 fs-6"
                       placeholder="Search your favorite dish..." />

                @if (Model.SelectedCategoryId.HasValue)
                {
                    <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                }

                <button type="submit" class="btn btn-dark px-4 fw-semibold">
                    <i class="bi bi-search me-1"></i> Search
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <button type="button"
                            class="btn btn-outline-secondary"
                            onclick="window.location.href='@Url.Action("Index", "Menu", new { CategoryId = Model.SelectedCategoryId })'">
                        Clear
                    </button>
                }
            </form>
        </div>
    </div>

    <!-- Category Tabs -->
    <div class="d-flex justify-content-center flex-wrap gap-2 mb-5">
        <a asp-action="Index"
           asp-route-searchTerm="@Model.SearchTerm"
           class="btn @(Model.SelectedCategoryId == null ? "btn-dark shadow" : "btn-outline-secondary") rounded-pill px-4 py-2 fw-medium transition-all">
            All Categories
        </a>

        @foreach (var category in Model.Categories)
        {
            <a asp-action="Index"
               asp-route-categoryId="@category.CategoryId"
               asp-route-searchTerm="@Model.SearchTerm"
               class="btn @(Model.SelectedCategoryId == category.CategoryId ? "btn-dark shadow" : "btn-outline-secondary") rounded-pill px-4 py-2 fw-medium transition-all">
                @category.Name
            </a>
        }
    </div>

    <!-- Dishes Grid -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @if (Model.Dishes.Any())
        {
            @foreach (var dish in Model.Dishes)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden card-hover transition-all">
                        <!-- Image Container -->
                        <div class="position-relative overflow-hidden" style="height: 220px;">
                            <img src="@(string.IsNullOrEmpty(dish.ImageUrl) ? "/assets/images/default-dish.jpg" : dish.ImageUrl)"
                                 class="card-img-top w-100 h-100 object-fit-cover transition-transform duration-300 img-zoom"
                                 alt="@dish.Name"
                                 onerror="this.src='https://images.pexels.com/photos/1279330/pexels-photo-1279330.jpeg';">

                            <!-- Price Badge -->
                            <span class="position-absolute top-0 end-0 m-3 badge bg-dark bg-opacity-75 backdrop-blur rounded-pill px-3 py-2 fs-6 fw-bold">
                                $@dish.Price.ToString("F2")
                            </span>
                        </div>

                        <!-- Body -->
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="mb-2">
                                <span class="badge bg-light text-secondary border fw-normal mb-2">@dish.Category?.Name</span>
                                <h5 class="card-title fw-bold text-dark mb-1">@dish.Name</h5>
                            </div>

                            <p class="card-text text-muted small flex-grow-1 line-clamp-2">
                                @dish.Description
                            </p>

                            <!-- Actions -->
                            <div class="d-flex gap-2 mt-4">
                                <a asp-action="Details" asp-route-id="@dish.DishId" class="btn btn-outline-dark rounded-3 w-100 fw-medium">
                                    <i class="bi bi-info-circle me-1"></i> Details & Add
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="p-5 bg-light rounded-4">
                    <i class="bi bi-search text-muted display-3 mb-3 d-block"></i>
                    <h4 class="fw-bold text-dark">No dishes found</h4>
                    <p class="text-muted">Try adjusting your search or category filters.</p>
                </div>
            </div>
        }
    </div>

    @* 📍 التعديل الخاص ببطاقات الإكسترا وتوجيه الفورم لـ CartController *@
    @if (Model.Extras != null && Model.Extras.Any())
    {
        <div class="mt-5 pt-4 border-top">
            <div class="d-flex align-items-center mb-3">
                <i class="bi bi-plus-circle-fill text-warning fs-3 me-2"></i>
                <h3 class="fw-bold mb-0">Available Extras & Add-ons</h3>
            </div>
            <p class="text-muted mb-4">Add your favorite extras directly to your cart</p>

            <div class="row g-3">
                @foreach (var extra in Model.Extras)
                {
                    <div class="col-md-3 col-sm-6">
                        <div class="card h-100 border-0 shadow-sm bg-light">
                            <div class="card-body d-flex flex-column justify-content-between p-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold mb-0">@extra.Name</h6>
                                    <span class="badge bg-warning text-dark fs-6">@extra.Price EGP</span>
                                </div>

                                <form asp-controller="Cart" asp-action="AddExtraToCart" method="post" class="mt-2">
                                    <input type="hidden" name="extraId" value="@extra.ExtraId" />
                                    <div class="input-group input-group-sm">
                                        <input type="number" name="quantity" value="1" min="1" class="form-control text-center" />
                                        <button type="submit" class="btn btn-outline-primary">
                                            <i class="bi bi-cart-plus me-1"></i> Add
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    .transition-all {
        transition: all 0.3s ease;
    }

    .card-hover:hover {
        transform: translateY(-6px);
        box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.1) !important;
    }

        .card-hover:hover .img-zoom {
            transform: scale(1.08);
        }

    .backdrop-blur {
        backdrop-filter: blur(8px);
    }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>