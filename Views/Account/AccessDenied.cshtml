@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Access Denied - Akalny</title>

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: Arial, Helvetica, sans-serif;
                background-color: #0f172a;
                color: #f8fafc;
            }

            .access-card {
                width: 90%;
                max-width: 500px;
                padding: 40px;
                text-align: center;
                background-color: #1e293b;
                border: 1px solid #334155;
                border-radius: 12px;
                box-shadow: 0 15px 40px rgba(0, 0, 0, 0.35);
            }

                .access-card h1 {
                    margin: 0 0 15px;
                    font-size: 42px;
                }

                .access-card p {
                    margin: 0;
                    color: #94a3b8;
                    font-size: 18px;
                    line-height: 1.6;
                }

            .back-button {
                display: inline-block;
                margin-top: 25px;
                padding: 12px 22px;
                background-color: #3b82f6;
                color: white;
                text-decoration: none;
                border-radius: 7px;
                font-weight: bold;
            }

                .back-button:hover {
                    background-color: #2563eb;
                }
    </style>
</head>

<body>

    <div class="access-card">

        <h1>Access Denied</h1>

        <p>
            You do not have permission to access this page.
        </p>

        <a asp-controller="Home"
           asp-action="Index"
           class="back-button">

            Back to Home

        </a>

    </div>

</body>
</html>